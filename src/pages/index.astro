---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HorizontalCard from '../components/HorizontalCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} sideBarActiveItem="Home">
  <div class="pb-8">
    <p class="text-xl text-base-content/70">Hey there!</p>
    <h1 class="text-5xl font-bold text-base-content mt-1">Ik ben Collin Thoman</h1>
    <p class="text-xl text-base-content/70 mt-1">Information Technology Leader</p>
    <p class="py-4 text-base-content/80 text-lg">
      I am passionate about technology. It is both my hobby and career. I built this site using AI as a proof-of-concept and to gain exposure to further capabilities of Claude Code.
      I enjoy learning and taking on new projects, whether it's home projects like Home Assistant and a private cloud, or building a personal blog like this, or enterprise projects like the Microsoft Power Platform and Identity & Access Management.
    </p>
  </div>

  <div class="divider"></div>

  <section>
    <h2 class="text-2xl font-bold text-base-content mb-6">Latest Posts</h2>
    {posts.map((post) => (
      <HorizontalCard
        title={post.data.title}
        description={post.data.description}
        href={`/blog/${post.id}/`}
        pubDate={post.data.pubDate}
        heroImage={post.data.heroImage}
      />
    ))}
  </section>

  <div class="flex justify-center mt-8">
    <a href="/blog" class="btn btn-primary">
      View All Posts
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
    </a>
  </div>
</BaseLayout>

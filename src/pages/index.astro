---
// Root redirect — Cloudflare Function handles server-side Accept-Language detection.
// This page is a client-side fallback for local dev and non-Cloudflare environments.
---

<html>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      const lang = navigator.language?.startsWith('nl') ? 'nl' : 'en';
      window.location.replace('/' + lang + '/');
    </script>
    <meta http-equiv="refresh" content="0;url=/en/" />
  </head>
  <body></body>
</html>

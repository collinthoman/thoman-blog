---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`404 - Page Not Found | ${SITE_TITLE}`} description="The page you're looking for doesn't exist.">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
    <h1 class="text-8xl font-bold text-primary mb-4">404</h1>
    <h2 class="text-2xl font-semibold text-base-content mb-4">Page Not Found</h2>
    <p class="text-base-content/70 mb-8 max-w-md">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <div class="flex gap-4">
      <a href="/en/" class="btn btn-primary">Go Home</a>
      <a href="/en/blog" class="btn btn-outline">Read Blog</a>
    </div>
  </div>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HorizontalCard from '../../../components/HorizontalCard.astro';
import { supportedLangs, type Lang } from '../../../i18n/config';
import { t } from '../../../i18n/utils';

export function getStaticPaths() {
  return supportedLangs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

const allPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// For Dutch: prefer Dutch posts, fall back to English
// For English: show only English posts
let posts;
if (lang === 'nl') {
  const byKey = new Map();
  for (const post of allPosts) {
    const key = post.data.translationKey ?? post.id;
    const existing = byKey.get(key);
    if (!existing || (post.data.lang ?? 'en') === 'nl') {
      byKey.set(key, post);
    }
  }
  posts = [...byKey.values()];
} else {
  posts = allPosts.filter((p) => (p.data.lang ?? 'en') === 'en');
}
---

<BaseLayout title={`${t(lang, 'ui', 'blogHeading')} | ${t(lang, 'ui', 'siteTitle')}`} description={t(lang, 'ui', 'siteDescription')} sideBarActiveItem="Blog" lang={lang}>
  <div class="pb-8">
    <h1 class="text-4xl font-bold text-base-content">{t(lang, 'ui', 'blogHeading')}</h1>
    <p class="py-4 text-base-content/80 text-lg">
      {t(lang, 'ui', 'blogDescription')}
    </p>
  </div>

  <div class="divider"></div>

  <section>
    {posts.map((post) => (
      <HorizontalCard
        title={post.data.title}
        description={post.data.description}
        href={`/${lang}/blog/${post.id}/`}
        pubDate={post.data.pubDate}
        heroImage={post.data.heroImage}
        tags={post.data.tags}
        lang={lang}
      />
    ))}
  </section>
</BaseLayout>

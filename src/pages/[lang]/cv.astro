---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supportedLangs, type Lang } from '../../i18n/config';
import { t, tRawArray } from '../../i18n/utils';

export function getStaticPaths() {
  return supportedLangs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

// Load structured data from translations
const glanceItems = ['years', 'users', 'budget', 'uptime'].map((key) => ({
  value: t(lang, 'cv', `glance.${key}.value`),
  label: t(lang, 'cv', `glance.${key}.label`),
}));

const jobs = tRawArray(lang, 'cv', 'experience.jobs') as any[];

const skillCategories = tRawArray(lang, 'cv', 'skills.categories') as { name: string; items: string[] }[];

const educationItems = tRawArray(lang, 'cv', 'education.items') as { name: string; institution: string; dates: string; honor: string }[];

const certItems = tRawArray(lang, 'cv', 'certifications.items') as { name: string; issuer: string; year: string }[];

const communityItems = tRawArray(lang, 'cv', 'community.items') as { name: string; description: string }[];
---

<BaseLayout title={`${t(lang, 'ui', 'nav.cv')} | ${t(lang, 'ui', 'siteTitle')}`} description={t(lang, 'cv', 'description')} sideBarActiveItem="CV" lang={lang}>

  <!-- Header -->
  <div class="pb-2">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-4xl font-bold text-base-content">{t(lang, 'cv', 'title')}</h1>
        <p class="text-lg text-base-content/70 mt-1">{t(lang, 'cv', 'jobTitle')}</p>
      </div>
      <a href="/cv.pdf" download class="btn btn-primary btn-sm w-fit">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        {t(lang, 'ui', 'downloadPdf')}
      </a>
    </div>

    <!-- Contact Links -->
    <div class="flex flex-wrap gap-4 text-sm text-base-content/70 mt-3">
      <a href="mailto:Collin.Thoman@gmail.com" class="flex items-center gap-1 hover:text-primary transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Collin.Thoman@gmail.com
      </a>
      <a href="https://www.linkedin.com/in/collinthoman/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 hover:text-primary transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        LinkedIn
      </a>
      <a href="https://github.com/collinthoman" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 hover:text-primary transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        GitHub
      </a>
      <span class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {t(lang, 'cv', 'location')}
      </span>
    </div>
  </div>

  <div class="divider"></div>

  <!-- At a Glance -->
  <section class="mb-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      {glanceItems.map((item) => (
        <div class="bg-base-200 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-primary">{item.value}</div>
          <div class="text-xs text-base-content/60 mt-1">{item.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- About -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold text-base-content mb-3">{t(lang, 'cv', 'about.heading')}</h2>
    <p class="text-base-content/80 leading-relaxed">{t(lang, 'cv', 'about.text1')}</p>
    <p class="text-base-content/80 leading-relaxed mt-3">{t(lang, 'cv', 'about.text2')}</p>
  </section>

  <!-- Experience -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold text-base-content mb-6">{t(lang, 'cv', 'experience.heading')}</h2>

    {jobs.map((job: any, index: number) => (
      <>
        {index > 0 && <div class="divider"></div>}
        <div class={index < jobs.length - 1 ? 'mb-8' : 'mb-2'}>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
            <h3 class="text-lg font-semibold text-base-content">{job.title}</h3>
            <span class="text-sm text-base-content/50 shrink-0">{job.dates}</span>
          </div>
          <p class="text-primary font-medium text-sm">{job.company} &middot; {job.location}</p>

          <p class="text-base-content/75 mt-3 text-sm leading-relaxed">{job.summary}</p>

          {job.accomplishments && job.accomplishments.length > 0 && (
            <div class="mt-4">
              <h4 class="text-sm font-semibold text-base-content/90 mb-2">{t(lang, 'cv', 'experience.keyAccomplishments')}</h4>
              <ul class="space-y-2 text-sm text-base-content/75">
                {job.accomplishments.map((item: string) => (
                  <li class="flex gap-2">
                    <span class="text-primary mt-1 shrink-0">&#9654;</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </>
    ))}
  </section>

  <!-- Skills -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold text-base-content mb-4">{t(lang, 'cv', 'skills.heading')}</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {skillCategories.map((cat) => (
        <div class="bg-base-200 rounded-xl p-4">
          <h3 class="text-sm font-semibold text-base-content mb-2">{cat.name}</h3>
          <div class="flex flex-wrap gap-1.5">
            {cat.items.map((item: string) => (
              <span class="badge badge-primary badge-sm">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Education & Certifications -->
  <section class="mb-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <h2 class="text-2xl font-bold text-base-content mb-4">{t(lang, 'cv', 'education.heading')}</h2>
        <div class="space-y-3">
          {educationItems.map((edu) => (
            <div class="bg-base-200 rounded-xl p-4">
              <h3 class="font-semibold text-base-content">{edu.name}</h3>
              <p class="text-primary text-sm font-medium mt-1">{edu.institution}</p>
              <p class="text-xs text-base-content/50 mt-1">{edu.dates}</p>
              {edu.honor && (
                <p class="text-xs text-base-content/60 mt-2 flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                  </svg>
                  {edu.honor}
                </p>
              )}
            </div>
          ))}
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-base-content mb-4">{t(lang, 'cv', 'certifications.heading')}</h2>
        <div class="bg-base-200 rounded-xl p-4 space-y-3">
          {certItems.map((cert) => (
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
              <div>
                <p class="font-semibold text-base-content text-sm">{cert.name}</p>
                <p class="text-xs text-base-content/50">{cert.issuer} &middot; {cert.year}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Community -->
  <section class="mb-4">
    <h2 class="text-2xl font-bold text-base-content mb-4">{t(lang, 'cv', 'community.heading')}</h2>
    <div class="flex flex-wrap gap-3">
      {communityItems.map((item, index) => (
        <div class="bg-base-200 rounded-xl px-4 py-3 flex items-center gap-2">
          {index === 0 && (
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          )}
          {index === 1 && (
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          )}
          {index === 2 && (
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          )}
          <div>
            <p class="text-sm font-medium text-base-content">{item.name}</p>
            <p class="text-xs text-base-content/50">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>

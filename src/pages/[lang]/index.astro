---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HorizontalCard from '../../components/HorizontalCard.astro';
import { supportedLangs, type Lang } from '../../i18n/config';
import { t } from '../../i18n/utils';

export function getStaticPaths() {
  return supportedLangs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

const allPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// For Dutch: prefer Dutch posts, fall back to English
// For English: show only English posts
let posts;
if (lang === 'nl') {
  const byKey = new Map();
  for (const post of allPosts) {
    const key = post.data.translationKey ?? post.id;
    const existing = byKey.get(key);
    if (!existing || (post.data.lang ?? 'en') === 'nl') {
      byKey.set(key, post);
    }
  }
  posts = [...byKey.values()].slice(0, 3);
} else {
  posts = allPosts.filter((p) => (p.data.lang ?? 'en') === 'en').slice(0, 3);
}
---

<BaseLayout title={t(lang, 'ui', 'siteTitle')} description={t(lang, 'ui', 'siteDescription')} sideBarActiveItem="Home" lang={lang}>
  <div class="pb-8">
    <p class="text-xl text-base-content/70">{t(lang, 'home', 'greeting')}</p>
    <h1 class="text-5xl font-bold text-base-content mt-1">{t(lang, 'home', 'heading')}</h1>
    <p class="text-xl text-base-content/70 mt-1">{t(lang, 'home', 'subtitle')}</p>
    <p class="py-4 text-base-content/80 text-lg">
      {t(lang, 'home', 'bio')}
    </p>
  </div>

  <div class="divider"></div>

  <section>
    <h2 class="text-2xl font-bold text-base-content mb-6">{t(lang, 'ui', 'latestPosts')}</h2>
    {posts.map((post) => (
      <HorizontalCard
        title={post.data.title}
        description={post.data.description}
        href={`/${lang}/blog/${post.id}/`}
        pubDate={post.data.pubDate}
        heroImage={post.data.heroImage}
        tags={post.data.tags}
        lang={lang}
      />
    ))}
  </section>

  <div class="flex justify-center mt-8">
    <a href={`/${lang}/blog`} class="btn btn-primary">
      {t(lang, 'ui', 'viewAllPosts')}
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
    </a>
  </div>
</BaseLayout>

  <!-- Volunteer Work -->
  <section class="mb-4">
    <h2 class="text-2xl font-bold text-base-content mb-4">Community</h2>
    <div class="flex flex-wrap gap-3">
      <div class="bg-base-200 rounded-xl px-4 py-3 flex items-center gap-2">

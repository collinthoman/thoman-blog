---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`CV | ${SITE_TITLE}`} description="Collin Thoman - IT Service Management Leader" sideBarActiveItem="CV">

  <!-- Header -->
  <div class="pb-2">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-4xl font-bold text-base-content">Collin Thoman</h1>
        <p class="text-lg text-base-content/70 mt-1">IT Service Management Leader</p>
      </div>
      <a href="/cv.pdf" download class="btn btn-primary btn-sm w-fit">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Download PDF
      </a>
    </div>

    <!-- Contact Links -->
    <div class="flex flex-wrap gap-4 text-sm text-base-content/70 mt-3">
      <a href="mailto:Collin.Thoman@gmail.com" class="flex items-center gap-1 hover:text-primary transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Collin.Thoman@gmail.com
      </a>
      <a href="https://www.linkedin.com/in/collinthoman/" target="_blank" class="flex items-center gap-1 hover:text-primary transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        LinkedIn
      </a>
      <a href="https://github.com/collinthoman" target="_blank" class="flex items-center gap-1 hover:text-primary transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        GitHub
      </a>
      <span class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Seattle, WA
      </span>
    </div>
  </div>

  <div class="divider"></div>

  <!-- At a Glance -->
  <section class="mb-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <div class="bg-base-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-primary">12+</div>
        <div class="text-xs text-base-content/60 mt-1">Years in IT</div>
      </div>
      <div class="bg-base-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-primary">186</div>
        <div class="text-xs text-base-content/60 mt-1">Users Supported</div>
      </div>
      <div class="bg-base-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-primary">$2.5M</div>
        <div class="text-xs text-base-content/60 mt-1">Budget Managed</div>
      </div>
      <div class="bg-base-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-primary">99.9%</div>
        <div class="text-xs text-base-content/60 mt-1">Uptime Maintained</div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold text-base-content mb-3">About</h2>
    <p class="text-base-content/80 leading-relaxed">
      I build and lead IT teams that deliver real business value. Over 12+ years I've grown from hands-on
      engineering into management, always staying close enough to the technical work to make informed decisions
      and mentor effectively. My approach blends ITIL discipline with agile flexibility &mdash; I care about
      service quality, security posture, and creating environments where people do their best work.
    </p>
    <p class="text-base-content/80 leading-relaxed mt-3">
      Currently learning Dutch and exploring IT leadership opportunities in the Netherlands/Belgium region.
      With established connections in the Benelux area and a strong commitment to cultural integration,
      I'm prepared for a transition to the EMEA market.
    </p>
  </section>

  <!-- Experience -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold text-base-content mb-6">Experience</h2>

    <!-- Seed IP - IT Manager -->
    <div class="mb-8">
      <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
        <h3 class="text-lg font-semibold text-base-content">Information Technology Manager</h3>
        <span class="text-sm text-base-content/50 shrink-0">Jul 2021 &ndash; Nov 2025</span>
      </div>
      <p class="text-primary font-medium text-sm">Seed IP Law Group &middot; Seattle, WA</p>

      <p class="text-base-content/75 mt-3 text-sm leading-relaxed">
        Led a team of six across help desk, systems, and security functions for a 186-person law firm.
        Owned the service delivery lifecycle, security program, and $2.5M annual IT budget while
        partnering with leadership to align technology investments with firm strategy.
      </p>

      <div class="mt-4 space-y-4">
        <div>
          <h4 class="text-sm font-semibold text-base-content/90 mb-2">Key Accomplishments</h4>
          <ul class="space-y-2 text-sm text-base-content/75">
            <li class="flex gap-2">
              <span class="text-primary mt-1 shrink-0">&#9654;</span>
              <span>Built ITIL-aligned service catalog, SLA framework, and change management processes that measurably improved deployment success rates</span>
            </li>
            <li class="flex gap-2">
              <span class="text-primary mt-1 shrink-0">&#9654;</span>
              <span>Deployed multi-layer security stack (CrowdStrike EDR, Rapid7 SIEM, Mimecast, Cisco Meraki) enabling the firm to pass client security audits and unlock new revenue</span>
            </li>
            <li class="flex gap-2">
              <span class="text-primary mt-1 shrink-0">&#9654;</span>
              <span>Launched satisfaction surveys in Jira Service Management &mdash; achieved 4.8/5 rating and improved response times by 25%</span>
            </li>
            <li class="flex gap-2">
              <span class="text-primary mt-1 shrink-0">&#9654;</span>
              <span>Developed training programs and a knowledge repository for the IT team, supporting succession planning and professional growth</span>
            </li>
            <li class="flex gap-2">
              <span class="text-primary mt-1 shrink-0">&#9654;</span>
              <span>Managed vendor relationships, contract negotiations, and technology procurement, driving cost savings on renewals</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <!-- Seed IP - SysAdmin -->
    <div class="mb-8">
      <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
        <h3 class="text-lg font-semibold text-base-content">System Administrator</h3>
        <span class="text-sm text-base-content/50 shrink-0">Aug 2018 &ndash; Jul 2021</span>
      </div>
      <p class="text-primary font-medium text-sm">Seed IP Law Group &middot; Seattle, WA</p>

      <p class="text-base-content/75 mt-3 text-sm leading-relaxed">
        Managed enterprise infrastructure through rapid growth (140 to 186 users) and the firm's
        emergency COVID-19 remote transition. Performance in this role led to the creation of the
        IT Manager position.
      </p>

      <div class="mt-4">
        <h4 class="text-sm font-semibold text-base-content/90 mb-2">Key Accomplishments</h4>
        <ul class="space-y-2 text-sm text-base-content/75">
          <li class="flex gap-2">
            <span class="text-primary mt-1 shrink-0">&#9654;</span>
            <span>Led unified communications migration from on-prem Cisco to Zoom Phone/Meetings/Chat, achieving 100% adoption through hands-on training and change management</span>
          </li>
          <li class="flex gap-2">
            <span class="text-primary mt-1 shrink-0">&#9654;</span>
            <span>Replaced legacy VPN and DNS security (Pulse Secure, Cisco Umbrella) with Cloudflare Zero Trust, modernizing remote access</span>
          </li>
          <li class="flex gap-2">
            <span class="text-primary mt-1 shrink-0">&#9654;</span>
            <span>Migrated from Zendesk to Jira Service Management &amp; Confluence with ITIL-aligned knowledge bases, cutting average resolution time by 10-15 minutes</span>
          </li>
          <li class="flex gap-2">
            <span class="text-primary mt-1 shrink-0">&#9654;</span>
            <span>Architected hybrid cloud environment (AWS EC2/VPC + Azure) with site-to-site VPN and redundant domain controllers for BCP/DR</span>
          </li>
          <li class="flex gap-2">
            <span class="text-primary mt-1 shrink-0">&#9654;</span>
            <span>Consolidated server footprint from 110 to 80 through strategic optimization, reducing operational costs</span>
          </li>
          <li class="flex gap-2">
            <span class="text-primary mt-1 shrink-0">&#9654;</span>
            <span>Spearheaded emergency transition to 100% remote work for 186 employees during COVID-19, leveraging pre-pandemic hardware standardization</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="divider"></div>

    <!-- Nuvodia -->
    <div class="mb-8">
      <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
        <h3 class="text-lg font-semibold text-base-content">IT Support Engineer</h3>
        <span class="text-sm text-base-content/50 shrink-0">Dec 2015 &ndash; Aug 2018</span>
      </div>
      <p class="text-primary font-medium text-sm">Nuvodia &middot; Spokane, WA</p>

      <p class="text-base-content/75 mt-3 text-sm leading-relaxed">
        Delivered managed IT services and consulting across multiple client organizations. Served as
        the primary on-site engineer and trusted IT advisor, handling everything from Windows Server
        and SharePoint administration to MDM deployments and automation scripting.
      </p>

      <ul class="mt-3 space-y-2 text-sm text-base-content/75">
        <li class="flex gap-2">
          <span class="text-primary mt-1 shrink-0">&#9654;</span>
          <span>Built documentation and knowledge management systems that enabled team scalability across client engagements</span>
        </li>
        <li class="flex gap-2">
          <span class="text-primary mt-1 shrink-0">&#9654;</span>
          <span>Created automation scripts for software deployments, reducing deployment time and manual errors</span>
        </li>
      </ul>
    </div>

    <div class="divider"></div>

    <!-- Geek Squad -->
    <div class="mb-2">
      <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
        <h3 class="text-lg font-semibold text-base-content">IT Field Engineer / Event Manager</h3>
        <span class="text-sm text-base-content/50 shrink-0">Aug 2010 &ndash; Jan 2016</span>
      </div>
      <p class="text-primary font-medium text-sm">Geek Squad &ndash; Best Buy &middot; Greater Seattle Area</p>

      <p class="text-base-content/75 mt-3 text-sm leading-relaxed">
        Started in residential and SMB IT support, then advanced to managing regional technology education
        events. Recruited and led teams of 20-35 temporary staff for events serving up to 200 youth participants,
        and built partnerships with non-profit organizations across the region.
      </p>
    </div>
  </section>

  <!-- Skills -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold text-base-content mb-4">Skills</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-base-200 rounded-xl p-4">
        <h3 class="text-sm font-semibold text-base-content mb-2">Cloud &amp; Infrastructure</h3>
        <div class="flex flex-wrap gap-1.5">
          <span class="badge badge-primary badge-sm">AWS (EC2, VPC, S3)</span>
          <span class="badge badge-primary badge-sm">Azure</span>
          <span class="badge badge-primary badge-sm">VMware ESXi/vCenter</span>
          <span class="badge badge-primary badge-sm">Hybrid Cloud</span>
        </div>
      </div>

      <div class="bg-base-200 rounded-xl p-4">
        <h3 class="text-sm font-semibold text-base-content mb-2">Security &amp; Compliance</h3>
        <div class="flex flex-wrap gap-1.5">
          <span class="badge badge-primary badge-sm">Cloudflare Zero Trust</span>
          <span class="badge badge-primary badge-sm">CrowdStrike EDR</span>
          <span class="badge badge-primary badge-sm">Rapid7 IDR</span>
          <span class="badge badge-primary badge-sm">Mimecast</span>
          <span class="badge badge-primary badge-sm">Intune</span>
        </div>
      </div>

      <div class="bg-base-200 rounded-xl p-4">
        <h3 class="text-sm font-semibold text-base-content mb-2">Service Management</h3>
        <div class="flex flex-wrap gap-1.5">
          <span class="badge badge-primary badge-sm">ITIL</span>
          <span class="badge badge-primary badge-sm">Agile / Scrum</span>
          <span class="badge badge-primary badge-sm">Jira Service Management</span>
          <span class="badge badge-primary badge-sm">Confluence</span>
          <span class="badge badge-primary badge-sm">Zendesk</span>
        </div>
      </div>

      <div class="bg-base-200 rounded-xl p-4">
        <h3 class="text-sm font-semibold text-base-content mb-2">Collaboration &amp; Productivity</h3>
        <div class="flex flex-wrap gap-1.5">
          <span class="badge badge-primary badge-sm">Microsoft 365</span>
          <span class="badge badge-primary badge-sm">Exchange Online</span>
          <span class="badge badge-primary badge-sm">SharePoint</span>
          <span class="badge badge-primary badge-sm">Zoom</span>
          <span class="badge badge-primary badge-sm">Power Platform</span>
          <span class="badge badge-primary badge-sm">iManage DMS</span>
        </div>
      </div>

      <div class="bg-base-200 rounded-xl p-4">
        <h3 class="text-sm font-semibold text-base-content mb-2">Networking</h3>
        <div class="flex flex-wrap gap-1.5">
          <span class="badge badge-primary badge-sm">Cisco Meraki</span>
          <span class="badge badge-primary badge-sm">Cloudflare</span>
          <span class="badge badge-primary badge-sm">VPN / SD-WAN</span>
        </div>
      </div>

      <div class="bg-base-200 rounded-xl p-4">
        <h3 class="text-sm font-semibold text-base-content mb-2">Leadership</h3>
        <div class="flex flex-wrap gap-1.5">
          <span class="badge badge-primary badge-sm">Team Development</span>
          <span class="badge badge-primary badge-sm">Strategic Planning</span>
          <span class="badge badge-primary badge-sm">Budget Management</span>
          <span class="badge badge-primary badge-sm">Vendor Relations</span>
          <span class="badge badge-primary badge-sm">Change Management</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Education & Certifications -->
  <section class="mb-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <h2 class="text-2xl font-bold text-base-content mb-4">Education</h2>
        <div class="space-y-3">
          <div class="bg-base-200 rounded-xl p-4">
            <h3 class="font-semibold text-base-content">Information Technology Management &amp; Administration</h3>
            <p class="text-primary text-sm font-medium mt-1">Western Governors University</p>
            <p class="text-xs text-base-content/50 mt-1">2014 &ndash; 2018</p>
          </div>
          <div class="bg-base-200 rounded-xl p-4">
            <h3 class="font-semibold text-base-content">Computers, Servers &amp; Networking</h3>
            <p class="text-primary text-sm font-medium mt-1">Sno-Isle Skills Center</p>
            <p class="text-xs text-base-content/50 mt-1">2006 &ndash; 2008</p>
            <p class="text-xs text-base-content/60 mt-2 flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
              National Technical Honor Society inductee
            </p>

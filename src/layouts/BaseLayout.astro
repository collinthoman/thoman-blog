---
import BaseHead from '../components/BaseHead.astro';
import SideBar from '../components/SideBar.astro';
import type { ImageMetadata } from 'astro';
import { defaultLang, type Lang } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  sideBarActiveItem?: string;
  lang?: Lang;
}

const { title, description, image, sideBarActiveItem, lang = defaultLang } = Astro.props;
---

<html lang={lang} data-theme="light">
  <head>
    <BaseHead title={title} description={description} image={image} lang={lang} />
    <script is:inline>
      // Apply saved theme immediately to prevent flash
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
    <!-- Cloudflare Web Analytics -->
    <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "90bda3e5447b41bcb243f5a059051d5a"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </head>
  <body class="bg-base-100 min-h-screen">
    <div class="drawer lg:drawer-open">
      <input id="sidebar-drawer" type="checkbox" class="drawer-toggle" />

      <!-- Main Content -->
      <div class="drawer-content flex flex-col">
        <!-- Mobile Header -->
        <div class="navbar bg-base-100 lg:hidden sticky top-0 z-30 border-b border-base-300">
          <div class="flex-none">
            <label for="sidebar-drawer" class="btn btn-square btn-ghost drawer-button">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-6 h-6 stroke-current">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </label>
          </div>
          <div class="flex-1">
            <a href={`/${lang}/`} class="btn btn-ghost text-xl">{title}</a>
          </div>
        </div>

        <!-- Page Content -->
        <main class="flex-grow p-4 md:p-8">
          <div class="max-w-4xl mx-auto">
            <slot />
          </div>
        </main>
      </div>

      <!-- Sidebar -->
      <div class="drawer-side z-40">
        <label for="sidebar-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
        <SideBar sideBarActiveItem={sideBarActiveItem} lang={lang} />
      </div>
    </div>
  </body>
</html>

---
import SideBarMenu from './SideBarMenu.astro';
import SideBarFooter from './SideBarFooter.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import profileImage from '../assets/profile.png';
import { defaultLang, type Lang } from '../i18n/config';
import { t } from '../i18n/utils';

interface Props {
  sideBarActiveItem?: string;
  lang?: Lang;
}

const { sideBarActiveItem, lang = defaultLang } = Astro.props;

const NAV_ITEMS = [
  { name: t(lang, 'ui', 'nav.home'), href: `/${lang}/` },
  { name: t(lang, 'ui', 'nav.blog'), href: `/${lang}/blog` },
  { name: t(lang, 'ui', 'nav.cv'), href: `/${lang}/cv` },
  { name: t(lang, 'ui', 'nav.about'), href: `/${lang}/about` },
];
---

<div class="bg-base-200 min-h-full w-80 p-4 flex flex-col">
  <!-- Profile Section -->
  <div class="flex flex-col items-center py-6">
    <div class="avatar mb-4">
      <div class="w-32 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2 bg-base-200">
        <img src={profileImage.src} alt="Collin Thoman" class="object-cover object-top" />
      </div>
    </div>
    <h2 class="text-2xl font-bold text-base-content">{t(lang, 'ui', 'siteTitle')}</h2>
  </div>

  <!-- Navigation -->
  <SideBarMenu items={NAV_ITEMS} activeItem={sideBarActiveItem} />

  <!-- Theme Switcher -->
  <div class="mt-4 px-2">
    <select id="theme-select" class="select select-bordered select-xs w-28 text-xs" data-choose-theme>
      <option value="light">Light</option>
      <option value="dark">Dark</option>
      <option value="cupcake">Cupcake</option>
      <option value="dracula">Dracula</option>
      <option value="night">Night</option>
      <option value="winter">Winter</option>
      <option value="nord">Nord</option>
      <option value="sunset">Sunset</option>
    </select>
  </div>

  <!-- Language Switcher -->
  <LanguageSwitcher lang={lang} currentPath={Astro.url.pathname} />

  <!-- Spacer -->
  <div class="flex-grow"></div>

  <!-- Footer -->
  <SideBarFooter lang={lang} />
</div>

<script is:inline>
  (function() {
    // Theme switcher logic
    const themeSelect = document.getElementById('theme-select');
    const currentTheme = localStorage.getItem('theme') || 'light';

    if (themeSelect) {
      themeSelect.value = currentTheme;
    }

    themeSelect?.addEventListener('change', (e) => {
      const theme = e.target.value;
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('theme', theme);
    });
  })();
</script>

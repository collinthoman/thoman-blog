---
import { defaultLang, type Lang } from '../i18n/config';

interface Props {
	date: Date;
	lang?: Lang;
}

const { date, lang = defaultLang } = Astro.props;

const localeMap: Record<string, string> = { en: 'en-US', nl: 'nl-NL' };
const locale = localeMap[lang] ?? 'en-US';
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(locale, {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>

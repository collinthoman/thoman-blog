---
import { languages, type Lang } from '../i18n/config';
import { getLocalizedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
---

<div class="flex gap-2 px-2 mt-2">
  {Object.entries(languages).map(([code, name]) => (
    <a
      href={getLocalizedPath(currentPath, code as Lang)}
      class:list={['btn btn-xs', code === lang ? 'btn-primary' : 'btn-ghost']}
      aria-label={name}
    >
      {code.toUpperCase()}
    </a>
  ))}
</div>

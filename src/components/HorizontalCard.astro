---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FormattedDate from './FormattedDate.astro';
import { defaultLang, type Lang } from '../i18n/config';
import { t } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  href: string;
  pubDate: Date;
  heroImage?: ImageMetadata;
  badge?: string;
  tags?: string[];
  lang?: Lang;
}

const { title, description, href, pubDate, heroImage, badge, tags = [], lang = defaultLang } = Astro.props;

// Translate tags if a translation exists
const translatedTags = tags.map((tag) => {
  const translated = t(lang, 'blog', `tags.${tag}`);
  return translated !== `tags.${tag}` ? translated : tag;
});
---

<a href={href} class="card card-side bg-base-100 shadow-xl hover:shadow-2xl transition-shadow mb-6 flex-col md:flex-row">
  {heroImage && (
    <figure class="md:w-72 shrink-0">
      <Image
        src={heroImage}
        alt={title}
        width={288}
        height={160}
        class="h-48 md:h-full w-full object-cover"
      />
    </figure>
  )}
  <div class="card-body">
    <div class="flex items-center gap-2">
      <h2 class="card-title text-base-content">{title}</h2>
      {badge && <div class="badge badge-secondary">{badge}</div>}
    </div>
    <p class="text-base-content/70 text-sm">
      <FormattedDate date={pubDate} lang={lang} />
    </p>
    <p class="text-base-content/80 line-clamp-2">{description}</p>
    {translatedTags.length > 0 && (
      <div class="flex flex-wrap gap-1 mt-1">
        {translatedTags.map((tag) => (
          <span class="badge badge-outline badge-xs">{tag}</span>
        ))}
      </div>
    )}
    <div class="card-actions justify-end">
      <span class="text-primary text-sm font-medium">{t(lang, 'ui', 'readMore')} &rarr;</span>
    </div>
  </div>
</a>
